
SECULLUM_EMAIL=
SECULLUM_PASSWORD=
SECULLUM_BANCO=
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql://user:password@localhost:5432/secullum10
REDIS_URL=redis://localhost:6379/0

APP_URL_BASE=https://exemplo.com

# Etapa 4 – WhatsApp / Mega-API (legado — mantido só para rollback; o
# transporte de envio agora é a Evolution API, ver abaixo)
MEGAAPI_HOST=apistart01.megaapi.com.br
MEGAAPI_INSTANCE=
MEGAAPI_TOKEN=
MEGAAPI_SECRET=
GESTOR_CELULAR=

# Migração Evolution API (transporte ativo de envio de WhatsApp)
EVOLUTION_HOST=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=secullum10
# Segredo de validação do webhook /whatsapp/webhook/evolution?token=...
# (a Evolution API não assina payloads com HMAC como a Mega-API fazia).
# Configurar esta mesma URL+token no painel Evolution Manager.
EVOLUTION_WEBHOOK_TOKEN=

# Etapa 4 – Whisper (opcional, para transcrição de áudio)
OPENAI_API_KEY=

# Etapa 5 – Flask-Mail (alertas de documentos vencendo)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
RH_EMAIL=
